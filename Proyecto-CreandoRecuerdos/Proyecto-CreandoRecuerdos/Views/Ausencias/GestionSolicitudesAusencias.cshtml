
@model IEnumerable<Proyecto_CreandoRecuerdos.Models.SolicitudAusenciaModel>

@{
    ViewData["Title"] = "Gestión de Solicitudes de Ausencias";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="@Url.Content("~/Templates/css/botones.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Templates/css/tablas.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Templates/css/paginaciones_y_exportaciones.css")" rel="stylesheet" />
}

<div class="my-5 text-center">
    <h2 class="mb-4" style="font-family: 'Sono', sans-serif;">
        <i class="fas fa-user-cog me-2"></i> Gestión de Solicitudes de Ausencias
    </h2>
</div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @section ListadoSolicitudesAusencias {
        <table class="table mb-0 table-bordered table-striped tabla-global text-center dataTable con-exportaciones con-busqueda" data-page-length="10" data-columnas-ocultas="8" data-titulo-exportacion="Listado de Solicitudes de Ausencias (Administrador)">
            <thead>
                <tr>
                    <th>ID Solicitud</th>
                    <th>ID Colaborador</th>
                    <th>Nombre</th>
                    <th>Fecha Inicio</th>
                    <th>Fecha Final</th>
                    <th>Tipo</th>
                    <th>Motivo</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.IdSolicitud</td>
                        <td>@item.IdUsuario</td>
                        <td>@item.NombreUsuario</td>
                        <td>@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                        <td>@item.FechaFin.ToString("dd/MM/yyyy")</td>
                        <td>@item.Tipo</td>
                        <td>@item.Motivo</td>
                        <td>@item.Estado</td>
                        <td>
                            @if (item.Estado == "Pendiente")
                            {
                                using (Html.BeginForm("Aprobar", "Ausencias", new { id = item.IdSolicitud }, FormMethod.Post, new { style = "display:inline;" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-success btn-sm">Aprobar</button>
                                }
                                using (Html.BeginForm("Rechazar", "Ausencias", new { id = item.IdSolicitud }, FormMethod.Post, new { style = "display:inline;" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm">Rechazar</button>
                                }
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.bundle.min.js"></script>
    <script src="@Url.Content("~/Templates/js/pdf/vfs_fonts.js")"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.colVis.min.js"></script>
    <script src="@Url.Content("~/Templates/js/paginaciones_y_exportaciones.js")"></script>
}
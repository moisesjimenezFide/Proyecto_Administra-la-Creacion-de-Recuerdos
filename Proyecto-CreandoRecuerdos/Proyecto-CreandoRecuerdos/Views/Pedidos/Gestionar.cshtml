﻿@{
    ViewData["Title"] = "Gestión de Pedidos";
}

@section Styles {
    <link href="~/Templates/css/pedidos.css" rel="stylesheet" />
}

<div class="container-fluid">
    <div class="card shadow p-4">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h4><i class="fas fa-clipboard-list me-2"></i> Gestionar Pedidos</h4>
                <div>
                    <button id="refreshBtn" class="btn btn-sm btn-light">
                        <i class="fas fa-sync-alt me-1"></i> Actualizar
                    </button>
                </div>
            </div>
        </div>

        <div class="card-body">
            <div class="px-3">
                <!-- Filtros avanzados -->
                <div class="row mb-3 g-3">
                    <div class="col-md-3">
                        <label class="form-label">Fecha Inicio</label>
                        <div class="custom-datepicker" data-input="fechaInicio">
                            <div class="datepicker-input">
                                <i class="fas fa-calendar-days calendar-icon"></i>
                            </div>
                            <div class="datepicker-calendar"></div>
                        </div>
                        <input type="text" class="form-control" id="fechaInicio" style="display:none;">
                    </div>


                    <div class="col-md-3">
                        <label class="form-label">Fecha Fin</label>
                        <div class="custom-datepicker" data-input="fechaFin">
                            <div class="datepicker-input">
                                <i class="fas fa-calendar-days calendar-icon"></i>
                            </div>
                            <div class="datepicker-calendar"></div>
                        </div>
                        <input type="text" class="form-control" id="fechaFin" style="display:none;">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Método Pago</label>
                        <select class="form-select" id="metodoPago">
                            <option value="">Todos</option>
                            <option value="Efectivo">Efectivo</option>
                            <option value="Tarjeta">Tarjeta</option>
                            <option value="Sinpe">Sinpe Móvil</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Items por página</label>
                        <select class="form-select" id="pageSize">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                    </div>
                </div>

                <!-- Filtros rápidos por estado -->
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <button class="btn btn-sm btn-outline-secondary filter-btn active" data-estado="">Todos</button>
                    <button class="btn btn-sm btn-outline-warning filter-btn" data-estado="Pendiente">Pendientes</button>
                    <button class="btn btn-sm btn-outline-info filter-btn" data-estado="En preparación">En preparación</button>
                    <button class="btn btn-sm btn-outline-success filter-btn" data-estado="Listo">Listos</button>
                    <button class="btn btn-sm btn-outline-primary filter-btn" data-estado="Entregado">Entregados</button>
                    <button class="btn btn-sm btn-outline-danger filter-btn" data-estado="Cancelado">Cancelados</button>
                </div>

            </div>

        </div>

        <!-- Tabla de pedidos -->
        <div class="table-responsive">
            <table class="table mb-0 table-bordered table-striped tabla-global text-center w-100">
                <thead class="tabla-global">
                    <tr>
                        <th>N° Pedido</th>
                        <th>ID Cliente</th>
                        <th>Fecha Inicio</th>
                        <th>Fecha Fin</th>
                        <th>Productos</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th>Método Pago</th>
                        <th>Para Llevar</th>
                        <th>Tiempo</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="pedidosBody" class="tabla-global">
                </tbody>
            </table>
        </div>

        <!-- Paginación -->
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center mt-3" id="pagination">
                <!-- La paginación se generará dinámicamente -->
            </ul>
        </nav>
    </div>
</div>


@section Scripts {
    <script src="~/Templates/js/gestionPedidos.js"></script>
}
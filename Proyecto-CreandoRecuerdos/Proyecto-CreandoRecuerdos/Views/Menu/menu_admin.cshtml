@model List<Proyecto_CreandoRecuerdos.Models.ProductoModel>

@{
    ViewData["Title"] = "Menú Admin";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@section Styles {
    <link href="@Url.Content("~/Templates/css/menu.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Templates/css/botones.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Templates/css/selects.css")" rel="stylesheet" />

    <style>
        .botones-admin {
            display: inline-flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn-admin-uniforme {
            width: 200px;
            min-width: 200px;
        }

        /* Para el grupo de dropdown */
        .btn-group.btn-admin-uniforme {
            width: 200px;
        }

            .btn-group.btn-admin-uniforme .dropdown-toggle {
                width: 100%;
                display: flex;
                justify-content: center;
                align-items: center;
            }
    </style>
}

<br />
<br />

<h2 style="font-family: 'Sono', sans-serif; text-align: center;">
    <i class="fas fa-user-cog me-2"></i> Menú Admin
</h2>

<div class="container my-5">
    <div class="text-center mb-5">
        <br><br>
        <h2 style="font-family: 'Sono', sans-serif;">
            <i class="fas fa-utensils me-2"></i> Categorías
        </h2>
        <div class="botones-admin">
            <button id="crear_producto" class="btn btn-sm btn-outline-dark-pink active btn-admin-uniforme">
                <i class="fas fa-plus me-1"></i> Crear producto
            </button>

            <div class="btn-group btn-admin-uniforme">
                <button type="button" class="btn btn-sm btn-outline-dark-pink dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fas fa-plus me-1"></i> Recomendación
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="#" id="crearRecomendacionOpcion">Crear recomendación</a></li>
                    <li><a class="dropdown-item" href="#" id="quitarRecomendacionOpcion">Quitar recomendación</a></li>
                </ul>
            </div>
        </div>
        <div class="d-flex flex-wrap justify-content-center gap-3 mt-4">
            <button class="btn btn-sm btn-outline-dark-pink active" data-category="todos">
                <i class="fas fa-th-list me-2"></i>Todo
            </button>
            <button class="btn btn-sm btn-outline-dark-pink" data-category="recomendaciones">
                <i class="fas fa-check me-1"></i> Recomendaciones
            </button>
            <button class="btn btn-sm btn-outline-dark-pink" data-category="desayunos">
                <i class="fas fa-coffee me-2"></i>Desayunos
            </button>
            <button class="btn btn-sm btn-outline-dark-pink" data-category="panini">
                <i class="fas fa-bread-slice me-2"></i>Panini
            </button>
            <button class="btn btn-sm btn-outline-dark-pink" data-category="crepes">
                <i class="fas fa-blender me-2"></i>Crêpes
            </button>
            <button class="btn btn-sm btn-outline-dark-pink" data-category="pasta">
                <i class="fas fa-pizza-slice me-2"></i>Pasta
            </button>
            <button class="btn btn-sm btn-outline-dark-pink" data-category="arroz">
                <i class="fas fa-utensils me-2"></i>Arroz
            </button>
            <button class="btn btn-sm btn-outline-dark-pink" data-category="tentaciones">
                <i class="fas fa-apple-alt me-2"></i>Tentaciones
            </button>
            <button class="btn btn-sm btn-outline-dark-pink" data-category="postres">
                <i class="fas fa-ice-cream me-2"></i>Delicias
            </button>
            <button class="btn btn-sm btn-outline-dark-pink" data-category="bebidas-calientes">
                <i class="fas fa-mug-hot me-2"></i>Bebidas Calientes
            </button>
            <button class="btn btn-sm btn-outline-dark-pink" data-category="bebidas-frias">
                <i class="fas fa-glass-whiskey me-2"></i>Bebidas Frías
            </button>
            <button class="btn btn-sm btn-outline-dark-pink" data-category="especiales">
                <i class="fas fa-star me-2"></i>Especiales
            </button>
        </div>
    </div>
</div>

<div class="pos-products">
    <div class="row justify-content-center">
        <div class="col-">
            <div class="row" id="productGrid">
                <!-- Se llenará -->
                @{
                    var recomendados = ViewBag.ProductosRecomendados as List<int> ?? new List<int>();
                }

                <div class="row" id="product-container">
                    @foreach (var producto in Model)
                    {
                        var esRecomendado = recomendados.Contains((int)producto.id_producto);
                        string imgUrl = string.IsNullOrEmpty(producto.img_url) ? "default.png" : producto.img_url;
                        var imgPath = Server.MapPath("~/Templates/img/menu/" + imgUrl);
                        if (!System.IO.File.Exists(imgPath)) { imgUrl = "default.png"; }

                        <div class="col-md-4 mb-4" data-category="@producto.id_categoria" data-recomendado="@(esRecomendado.ToString().ToLower())">
                            <div class="card h-100 border-0 shadow-sm product-card">
                                <div class="card-img-container text-center">
                                    <img src="~/Templates/img/menu/@imgUrl?v=@DateTime.Now.Ticks" class="card-img-top" alt="@producto.nombre" style="max-width: 120px;">
                                </div>
                                <div class="card-body">
                                    <h5 class="card-title" style="font-family: 'Sono', sans-serif; font-weight: bold;">@producto.nombre</h5>
                                    <p class="card-text" style="white-space: pre-line;">@producto.descripcion</p>
                                    <span class="fw-bold dark-violet">₡@producto.precio_por_unidad.ToString("N0")</span>
                                    <div class="d-flex justify-content-between mt-3">
                                        <a href="#" class="btn btn-primary btn-sm"
                                           data-id_edit="@producto.id_producto.ToString()"
                                           data-nombre="@(producto.nombre ?? "")"
                                           data-descripcion="@(producto.descripcion ?? "")"
                                           data-precio="@producto.precio_por_unidad.ToString()"
                                           data-img="@(producto.img_url ?? "")"
                                           data-category="@producto.id_categoria.ToString()">
                                            <i class="fas fa-edit me-1"></i> Editar
                                        </a>
                                        <a href="#" class="btn btn-danger btn-sm" data-id_eliminar="@producto.id_producto">
                                            <i class="fas fa-trash-alt me-1"></i> Eliminar
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <!-- Fin -->

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>var esAdmin = true;</script>
    <script src="@Url.Content("~/Templates/js/menu.js")"></script>
    <script>
        function SwalSelect(containerSelector, opciones, textoDefault = "Seleccione") {

            const container = document.querySelector(containerSelector);
            if (!container) return;

            const hiddenInput = document.createElement("input");
            hiddenInput.type = "hidden";
            hiddenInput.value = "";
            hiddenInput.className = "swal-custom-select-value";

            const wrapper = document.createElement("div");
            wrapper.className = "custom-select";

            const button = document.createElement("button");
            button.type = "button";
            button.className = "custom-select-button";
            button.textContent = textoDefault;

            const menu = document.createElement("div");
            menu.className = "custom-select-menu";

            Object.entries(opciones).forEach(([texto, valor]) => {
                const item = document.createElement("div");
                item.className = "custom-select-item";
                item.dataset.value = valor;
                item.textContent =
                    texto.charAt(0).toUpperCase() + texto.slice(1).replace("-", " ");

                item.onclick = () => {
                    hiddenInput.value = valor;
                    button.textContent = item.textContent;

                    menu.querySelectorAll(".custom-select-item")
                        .forEach(i => i.classList.remove("active"));
                    item.classList.add("active");

                    menu.classList.remove("show");
                    button.classList.remove("open");
                };

                menu.appendChild(item);
            });

            button.onclick = () => {
                button.classList.toggle("open");
                menu.classList.toggle("show");
            };

            document.addEventListener("click", (e) => {
                if (!wrapper.contains(e.target)) {
                    button.classList.remove("open");
                    menu.classList.remove("show");
                }
            });

            wrapper.appendChild(button);
            wrapper.appendChild(menu);

            container.innerHTML = "";
            container.appendChild(wrapper);
            container.appendChild(hiddenInput);

            // Método para seleccionar valor al abrir Swal
            hiddenInput.setValue = (valor) => {
                hiddenInput.value = valor;

                const item = menu.querySelector(`[data-value="${valor}"]`);
                if (item) {
                    // activar visual
                    menu.querySelectorAll(".custom-select-item")
                        .forEach(i => i.classList.remove("active"));

                    item.classList.add("active");
                    button.textContent = item.textContent;
                }
            };

            return hiddenInput;
        }
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const productContainer = document.getElementById('product-container');
            const crearBtn = document.getElementById('crear_producto');
            if (crearBtn) {
                crearBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    crear_funcion();
                });
            }

            productContainer.addEventListener('click', function (e) {
                // se genera un triger para saber cuando se pulsa un boton
                const target = e.target;
                let editar_btn = null;
                if (target.matches('a.btn.btn-primary')) {
                    editar_btn = target;
                } else {
                    editar_btn = target.closest('a.btn.btn-primary');
                }
                const eliminar_btn = target.closest('a.btn.btn-danger');

                if (editar_btn) {
                    //Validar boton editar
                    e.preventDefault();
                    editar_funcion(editar_btn);
                } else if (eliminar_btn) {
                    //Validar boton eliminar
                    e.preventDefault();
                    eliminar_funcion(eliminar_btn)
                }
            });
        });

        //Mis funciones
        const categoryMap = {
            'desayunos': 1,
            'panini': 2,
            'crepes': 3,
            'pasta': 4,
            'arroz': 5,
            'tentaciones': 6,
            'postres': 7,
            'bebidas-calientes': 8,
            'bebidas-frias': 9,
            'especiales': 10
        };

        function editar_funcion(btn) {

            const id = btn.dataset.id_edit;
            let nombre = btn.dataset.nombre || "";
            let descripcion = btn.dataset.descripcion || "";
            let precio = btn.dataset.precio || "";
            let img = btn.dataset.img || "";
            const categoriaActual = btn.dataset.category || "";

            const imgUrlFinal = img ? img : "default.png";

            Swal.fire({
                title: `Editar Producto: ${nombre}`,
                html:
                    `<label>Nombre:</label>
                 <input id="swal-nombre" class="swal2-input" value="${nombre}">

                 <input type="hidden" id="swal-id" value="${id}">

                 <label>Descripción:</label>
                 <textarea id="swal-descripcion" class="swal2-textarea">${descripcion}</textarea>

                 <label>Precio:</label>
                 <input id="swal-precio" class="swal2-input" value="${precio}"
                    oninput="this.value=this.value.replace(/[^0-9.]/g,'');">

                 <label>Categoría:</label>
                 <div id="swal-categoria"></div>

                 <p class="mt-2">Imagen actual:</p>
                 <img src="/Templates/img/menu/${imgUrlFinal}" class="swal2-image" style="max-height:100px;">

                 <p class="mt-2">Cargar nueva imagen:</p>
                 <input type="file" id="swal-img" class="swal2-file">
                `,
                focusConfirm: false,
                showCancelButton: true,
                confirmButtonText: 'Guardar',
                confirmButtonColor: '#B54885',
                cancelButtonColor: '#6C757D',

                didOpen: () => {
                    window._categoriaInput = SwalSelect("#swal-categoria", categoryMap);
                    _categoriaInput.setValue(categoriaActual);
                },

                preConfirm: () => {
                    const nombreVal = document.getElementById('swal-nombre').value.trim();
                    const descripcionVal = document.getElementById('swal-descripcion').value.trim();
                    const precioStr = document.getElementById('swal-precio').value.trim();
                    const categoriaVal = _categoriaInput.value;

                    if (!nombreVal || !descripcionVal || !precioStr || !categoriaVal) {
                        Swal.showValidationMessage("Todos los campos son obligatorios.");
                        return false;
                    }

                    const precioVal = parseFloat(precioStr);
                    if (isNaN(precioVal) || precioVal <= 0) {
                        Swal.showValidationMessage("El precio debe ser mayor que cero.");
                        return false;
                    }

                    return {
                        id: id,
                        nombre: nombreVal,
                        descripcion: descripcionVal,
                        precio: precioVal,
                        categoria: categoriaVal,
                        imagen: document.getElementById('swal-img').files[0],
                        imagenActual: img
                    };
                }
            }).then(r => {
                if (!r.isConfirmed) return;

                const datos = r.value;
                const formData = new FormData();

                formData.append('Id', datos.id);
                formData.append('Nombre', datos.nombre);
                formData.append('Descripcion', datos.descripcion);
                formData.append('Precio', datos.precio);
                formData.append('IdCategoria', datos.categoria);
                formData.append('ImagenActual', datos.imagenActual);

                if (datos.imagen) formData.append('Imagen', datos.imagen);

                $.ajax({
                    url: '/Menu/menu_admin',
                    type: 'POST',
                    data: formData,
                    contentType: false,
                    processData: false,
                    success: function () {
                        Swal.fire('¡Guardado!', 'El producto fue actualizado.', 'success')
                            .then(() => location.reload());
                    },
                    error: function () {
                        Swal.fire('Error', 'Ocurrió un problema al actualizar.', 'error');
                    }
                });
            });
        }

        function eliminar_funcion(btn) {
            const id = btn.getAttribute('data-id_eliminar');

            Swal.fire({
                title: '¿Estás seguro?',
                html: 'Esta acción eliminará el producto.<br>Escribe <strong>CONFIRMAR</strong> para continuar.',
                input: 'text',
                inputPlaceholder: 'Escribe CONFIRMAR',
                showCancelButton: true,
                confirmButtonText: 'Eliminar',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#DC3545',
                cancelButtonColor: '#6C757D',
                preConfirm: (valor) => {
                    if (valor !== 'CONFIRMAR') {
                        Swal.showValidationMessage('Debes escribir CONFIRMAR exactamente.');
                        return false;
                    }
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    // Enviar AJAX para eliminar
                    $.ajax({
                        url: '/Menu/eliminar_producto', // Ajusta la URL según tu controlador
                        type: 'POST',
                        data: { id: id },
                        success: function () {
                            Swal.fire('Eliminado', 'El producto fue eliminado exitosamente.', 'success')
                                .then(() => location.reload());
                        },
                        error: function () {
                            Swal.fire('Error', 'Ocurrió un problema al eliminar el producto.', 'error');
                        }
                    });
                }
            });
        }

        function crear_funcion() {

            Swal.fire({
                title: 'Crear nuevo producto',
                html:
                    `<label>Nombre:</label>
                 <input id="swal-nombre" class="swal2-input">

                 <label>Descripción:</label>
                 <textarea id="swal-descripcion" class="swal2-textarea"></textarea>

                 <label>Precio:</label>
                 <input id="swal-precio" class="swal2-input" inputmode="decimal"
                    oninput="this.value=this.value.replace(/[^0-9.]/g,'');">

                 <label>Categoría:</label>
                 <div id="swal-categoria"></div>

                 <p class="mt-2">Cargar imagen:</p>
                 <input type="file" id="swal-img" class="swal2-file">
                `,
                focusConfirm: false,
                showCancelButton: true,
                confirmButtonText: 'Crear',
                confirmButtonColor: '#B54885',
                cancelButtonColor: '#6C757D',

                didOpen: () => {
                    window._categoriaInput = SwalSelect("#swal-categoria", categoryMap);
                },

                preConfirm: () => {

                    const nombre = document.getElementById('swal-nombre').value.trim();
                    const descripcion = document.getElementById('swal-descripcion').value.trim();
                    const precioStr = document.getElementById('swal-precio').value.trim();
                    const categoria = _categoriaInput.value;
                    const imagen = document.getElementById('swal-img').files[0];

                    if (!nombre || !descripcion || !precioStr || !imagen || !categoria) {
                        Swal.showValidationMessage('Todos los campos son obligatorios.');
                        return false;
                    }

                    const precio = parseFloat(precioStr);
                    if (isNaN(precio) || precio <= 0) {
                        Swal.showValidationMessage('El precio debe ser mayor que cero.');
                        return false;
                    }

                    return { nombre, descripcion, precio, categoria, imagen };
                }
            }).then(r => {
                if (!r.isConfirmed) return;

                const datos = r.value;
                const formData = new FormData();

                formData.append('Nombre', datos.nombre);
                formData.append('Descripcion', datos.descripcion);
                formData.append('Precio', datos.precio);
                formData.append('IdCategoria', datos.categoria);
                formData.append('Imagen', datos.imagen);

                $.ajax({
                    url: '/Menu/crear_producto',
                    type: 'POST',
                    data: formData,
                    contentType: false,
                    processData: false,
                    success: function () {
                        Swal.fire('¡Creado!', 'El producto fue registrado exitosamente.', 'success')
                            .then(() => location.reload());
                    },
                    error: function () {
                        Swal.fire('Error', 'No se pudo crear el producto.', 'error');
                    }
                });
            });
        }
    </script>

    <script>
        $(document).ready(function () {
            // Opción 1: Crear recomendación (abre SweetAlert con formulario)
            $('#crearRecomendacionOpcion').click(function (e) {
                e.preventDefault();
                abrirFormularioRecomendacion();
            });

            // Opción 2: Quitar recomendación (abre SweetAlert con select personalizado)
            $('#quitarRecomendacionOpcion').click(function (e) {
                e.preventDefault();

                $.get('/Menu/RecomendacionesAjax', function (productos) {

                    // Convertimos el array en un map para SwalSelect()
                    let map = {};
                    productos.forEach(prod => {
                        map[prod.nombre] = prod.id_producto;
                    });

                    Swal.fire({
                        title: 'Quitar recomendación',
                        html: `
                <label>Quitar recomendación existente:</label>
                <div id="swal-quitar-recomendacion"></div>
            `,
                        showCancelButton: true,
                        confirmButtonText: 'Eliminar',
                        confirmButtonColor: '#DC3545',
                        cancelButtonColor: '#6C757D',

                        didOpen: () => {
                            // Crear dropdown pastel con los productos recomendados
                            window._inputQuitarRecomendacion = SwalSelect(
                                "#swal-quitar-recomendacion",
                                map,
                                "Seleccione una recomendación"
                            );
                        },

                        preConfirm: () => {
                            const id = _inputQuitarRecomendacion.value;

                            if (!id) {
                                Swal.showValidationMessage('Debes seleccionar una recomendación.');
                                return false;
                            }

                            return id;
                        }

                    }).then(result => {
                        if (result.isConfirmed) {

                            $.post('/Menu/EliminarRecomendacion', { id: result.value }, function () {

                                Swal.fire('Eliminado', 'La recomendación fue quitada.', 'success')
                                    .then(() => location.reload());

                            }).fail(() => {

                                Swal.fire('Error', 'No se pudo quitar la recomendación.', 'error');
                            });
                        }
                    });
                });
            });
        });

        function abrirFormularioRecomendacion() {

            $.get('/Menu/ObtenerProductosDisponibles', function (productos) {

                let map = {};
                productos.forEach(p => map[p.nombre] = p.id_producto);

                Swal.fire({
                    title: 'Crear recomendación',
                    html:
                        `<label>Seleccionar producto:</label>
                 <div id="swal-producto"></div>

                 <label for="motivo">Motivo:</label>
                 <textarea id="motivo" class="swal2-textarea" placeholder="Ej: Producto más vendido, alta demanda, etc."></textarea>`,

                    showCancelButton: true,
                    confirmButtonText: 'Crear',
                    confirmButtonColor: '#B54885', 
                    cancelButtonColor: '#6C757D',

                    didOpen: () => {
                        window._productoInput = SwalSelect("#swal-producto", map);
                    },

                    preConfirm: () => {
                        const idProducto = _productoInput.value;
                        const motivo = document.getElementById('motivo').value.trim();

                        if (!idProducto || !motivo) {
                            Swal.showValidationMessage('Debés seleccionar un producto y escribir un motivo.');
                            return false;
                        }

                        return { productoId: idProducto, motivo };
                    }
                }).then(r => {
                    if (!r.isConfirmed) return;

                    $.post('/Menu/GuardarRecomendacion', r.value, function () {
                        Swal.fire('¡Listo!', 'Recomendación creada con éxito.', 'success')
                            .then(() => location.reload());
                    }).fail(() => {
                        Swal.fire('Error', 'No se pudo crear la recomendación.', 'error');
                    });
                });
            });
        }
    </script>
}
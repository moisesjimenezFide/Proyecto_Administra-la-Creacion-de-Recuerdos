@model Proyecto_CreandoRecuerdos.Models.InsumosModel

@{
    ViewData["Title"] = "Gestión de Costos de Productos Preparados";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool editando = ViewBag.Editando ?? false;
    var productoPreparadoEditado = Model.ProductoPreparadoEditado;
    string titulo = editando ? "Edición de Productos Preparados" : "Registro de Productos Preparados";
    string textoBoton = editando ? "Actualizar" : "Agregar";
    string accion = editando ? "EditarProductoPreparado" : "CrearProductoPreparado";
}

@section Styles {
    <link href="~/Templates/css/insumos.css" rel="stylesheet" />
}

<div class="container my-5 text-center">
    <h2 class="mb-4" style="font-family: 'Sono';">
        <i class="fas fa-calculator me-2"></i>Gestión de Costos de Productos Preparados
    </h2>
</div>

<!-- Formulario de búsqueda -->
<form method="get" action="@Url.Action("productos_preparados", "Insumos")" class="mt-4">
    <div class="input-group mb-4">
        <input type="text" name="search" class="form-control" placeholder="Buscar por cualquier campo..." value="@ViewBag.Search" />
        <button type="submit" class="fas fa-search ms-1 btn btn-custom-pink" title="Buscar"></button>
    </div>
</form>

<!-- Formulario de registro/edición -->
<div class="container">
    <h4 class="mb-3"><strong>@titulo</strong></h4>
    @using (Html.BeginForm(accion, "Insumos", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        if (editando)
        {
            @:<input type="hidden" name="id" value="@productoPreparadoEditado.id" />
        }

        if (ViewBag.Errores != null)
        {
            @:<script>
           @:     $(function () {
           @:         Swal.fire({
           @:             icon: 'error',
           @:             title: 'Validación',
           @:             html: '@Html.Raw(string.Join("<br/>", (IEnumerable<string>)ViewBag.Errores))',
           @:             confirmButtonText: 'Aceptar',
           @:             confirmButtonColor: '#E27AB0'
           @:         });
           @:     });
           @: </script>
        }

        <div class="mb-3 text-start">
            <label for="tipo" class="form-label">Tipo</label>
            <input type="text" name="tipo" id="tipo" class="form-control" value="@(editando ? productoPreparadoEditado.tipo : "")" />
        </div>

        <div class="mb-3 text-start">
            <label for="nombre" class="form-label">Nombre</label>
            <input type="text" name="nombre" id="nombre" class="form-control" value="@(editando ? productoPreparadoEditado.nombre : "")" />
        </div>

        <div class="mb-3 text-start">
            <label for="marca" class="form-label">Marca</label>
            <input type="text" name="marca" id="marca" class="form-control" value="@(editando ? productoPreparadoEditado.marca : "")" />
        </div>

        <div class="mb-3 text-start">
            <label for="cantidad" class="form-label">Cantidad</label>
            <input type="number" name="cantidad" id="cantidad" class="form-control" value="@(editando ? productoPreparadoEditado.cantidad.ToString() : "")" min="1" />
        </div>

        <div class="mb-3 text-start">
            <label for="proveedor" class="form-label">Proveedor</label>
            <input type="text" name="proveedor" id="proveedor" class="form-control" value="@(editando ? productoPreparadoEditado.proveedor : "")" />
        </div>

        <div class="mb-3 text-start">
            <label for="volumen_de_porcion" class="form-label">Volumen de Porción</label>
            <input type="number" name="volumen_de_porcion" id="volumen_de_porcion" class="form-control" value="@(editando ? productoPreparadoEditado.volumen_de_porcion.ToString() : "")" />
        </div>

        <div class="mb-3 text-start">
            <label for="costo" class="form-label">Costo</label>
            <input type="number" name="costo" id="costo" class="form-control" value="@(editando ? (productoPreparadoEditado.costo.HasValue ? productoPreparadoEditado.costo.Value.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : "") : "")" step="0.01" lang="en" />
        </div>

        <div class="mb-3 text-start">
            <label for="unidad_de_medida" class="form-label">Unidad de Medida</label>
            <input type="text" name="unidad_de_medida" id="unidad_de_medida" class="form-control" value="@(editando ? productoPreparadoEditado.unidad_de_medida : "")" />
        </div>

        <div class="d-flex justify-content-end gap-2">
            @if (editando)
            {
                <a href="@Url.Action("productos_preparados", "Insumos")" class="btn btn-secondary">Salir</a>
            }
            <button type="reset" class="btn btn-danger">Cancelar</button>
            <button type="submit" class="btn btn-custom-pink">@textoBoton</button>
        </div>
    }
</div>

<!-- Listado -->
<div class="container">
    <h4><strong>Listado de Productos Preparados</strong></h4>
    @if (Model.ProductosPreparados == null || Model.ProductosPreparados.Count == 0)
    {
        <div class="alert alert-info text-center" style="margin: 1rem 0;">
            @if (!string.IsNullOrEmpty(ViewBag.Search as string))
            {
                <span>No se encontraron coincidencias.</span>
            }
            else
            {
                <span>No hay productos preparados registrados.</span>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-sm text-center">
                <thead>
                    <tr>
                        <th>Tipo</th>
                        <th>Nombre</th>
                        <th>Marca</th>
                        <th>Cantidad</th>
                        <th>Proveedor</th>
                        <th>Volumen de Porción</th>
                        <th>Costo (₡)</th>
                        <th>Peso</th>
                        <th>Unidad de medida</th>
                        <th>Costo por Peso (₡)</th>
                        <th>Costo por Porción con Merma (₡)</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var producto_preparado in Model.ProductosPreparados)
                    {
                        <tr>
                            <td>@producto_preparado.tipo</td>
                            <td>@producto_preparado.nombre</td>
                            <td>@producto_preparado.marca</td>
                            <td>@producto_preparado.cantidad</td>
                            <td>@producto_preparado.proveedor</td>
                            <td>@producto_preparado.volumen_de_porcion</td>
                            <td>
                                @(producto_preparado.costo.HasValue ? "₡" + producto_preparado.costo.Value.ToString("N2") : "")
                            </td><td>@(producto_preparado.cantidad * producto_preparado.volumen_de_porcion)</td>
                            <td>@producto_preparado.unidad_de_medida</td>
                            <td>₡@producto_preparado.costo_por_peso.ToString("N2")</td>
                            <td>₡@producto_preparado.costo_por_porcion_con_merma.ToString("N2")</td>
                            <td>
                                <a href="@Url.Action("EditarProductoPreparado", "Insumos", new { id = producto_preparado.id })" class="btn btn-custom-pink btn-sm fas fa-pencil" title="Editar"></a>
                                <a href="@Url.Action("EliminarProductoPreparado", "Insumos", new { id = producto_preparado.id })" class="btn btn-danger btn-sm btn-eliminar fas fa-trash" title="Eliminar" data-url="@Url.Action("EliminarProductoPreparado", "Insumos", new { id = producto_preparado.id })"></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script src="~/Templates/js/insumos.js"></script>
    @Html.Partial("accion_exitosa")
}

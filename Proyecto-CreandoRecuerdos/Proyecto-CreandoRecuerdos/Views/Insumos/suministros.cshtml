@model Proyecto_CreandoRecuerdos.Models.InsumosModel

@{
    ViewData["Title"] = "Gestión de Costos de Suministros";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool editando = ViewBag.Editando ?? false;
    var suministroEditado = Model.SuministroEditado;
    string titulo = editando ? "Edición de Suministros" : "Registro de Suministros";
    string textoBoton = editando ? "Actualizar" : "Agregar";
    string accion = editando ? "EditarSuministro" : "CrearSuministro";
}

@section Styles {
    <link href="~/Templates/css/insumos.css" rel="stylesheet" />
}

<div class="container my-5 text-center">
    <h2 class="mb-4" style="font-family: 'Sono';">
        <i class="fas fa-calculator me-2"></i> Gestión de Costos de Suministros
    </h2>
</div>

<!-- Formulario de búsqueda -->
<form method="get" action="@Url.Action("suministros", "Insumos")" class="mt-4">
    <h4><strong>Búsqueda de suministros</strong></h4>
    <div class="input-group mb-4">
        <input type="text" name="search" class="form-control" placeholder="Buscar por cualquier campo..." value="@ViewBag.Search" />
        <button type="submit" class=" fas fa-search ms-1 btn btn-custom-pink" title="Buscar"></button>
    </div>
</form>

<!-- Formulario de registro/edición -->
<div class="container">
    <h4 class="mb-3"><strong>@titulo</strong></h4>

    @using (Html.BeginForm(accion, "Insumos", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        if (editando)
        {
            @:<input type="hidden" name="id" value="@suministroEditado.id" />
        }

        if (ViewBag.Errores != null)
        {
            @:<script>
           @:     $(function () {
           @:         Swal.fire({
           @:             icon: 'error',
           @:             title: 'Validación',
           @:             html: '@Html.Raw(string.Join("<br/>", (IEnumerable<string>)ViewBag.Errores))',
           @:             confirmButtonText: 'Aceptar',
           @:             confirmButtonColor: '#E27AB0'
           @:         });
           @:     });
           @: </script>
        }

        <div class="mb-3 text-start">
            <label for="nombre" class="form-label">Nombre</label>
            <input type="text" name="nombre" id="nombre" class="form-control" value="@(editando ? suministroEditado.nombre : "")" />
        </div>

        <div class="mb-3 text-start">
            <label for="marca" class="form-label">Marca</label>
            <input type="text" name="marca" id="marca" class="form-control" value="@(editando ? suministroEditado.marca : "")" />
        </div>

        <div class="mb-3 text-start">
            <label for="presentacion" class="form-label">Presentación</label>
            <input type="text" name="presentacion" id="presentacion" class="form-control" value="@(editando ? suministroEditado.presentacion : "")" />
        </div>

        <div class="mb-3 text-start">
            <label for="proveedor" class="form-label">Proveedor</label>
            <input type="text" name="proveedor" id="proveedor" class="form-control" value="@(editando ? suministroEditado.proveedor : "")" />
        </div>

        <div class="mb-3 text-start">
            <label for="costo" class="form-label">Costo</label>
            <input type="number" name="costo" id="costo" class="form-control" value="@(editando ? suministroEditado.costo.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : "")" step="0.01" lang="en" />
        </div>

        <div class="mb-3 text-start">
            <label for="cantidad" class="form-label">Cantidad</label>
            <input type="number" name="cantidad" id="cantidad" class="form-control" value="@(editando ? suministroEditado.cantidad.ToString() : "")" />
        </div>

        <div class="mb-3 text-start">
            <label for="unidad_de_medida" class="form-label">Unidad de Medida</label>
            <input type="text" name="unidad_de_medida" id="unidad_de_medida" class="form-control" required="required" value="@(editando ? suministroEditado.unidad_de_medida : "")" />
        </div>

        <div class="d-flex justify-content-end gap-2">
            @if (editando)
            {
                <a href="@Url.Action("suministros", "Insumos")" class="btn btn-secondary">Salir</a>
            }
            <button type="reset" class="btn btn-danger">Cancelar</button>
            <button type="submit" class="btn btn-custom-pink">@textoBoton</button>
        </div>
    }
</div>

<!-- Listado -->
<div class="container">
    <h4><strong>Listado de Suministros</strong></h4>
    @if (Model.Suministros == null || Model.Suministros.Count == 0)
    {
        <div class="alert alert-info text-center" style="margin: 1rem 0;">
            @if (!string.IsNullOrEmpty(ViewBag.Search as string))
            {
                <span>No se encontraron coincidencias.</span>
            }
            else
            {
                <span>No hay suministros registrados.</span>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-sm text-center">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Marca</th>
                        <th>Presentación</th>
                        <th>Proveedor</th>
                        <th>Costo (₡)</th>
                        <th>Cantidad</th>
                        <th>Unidad de Medida</th>
                        <th>Costo por Cantidad (₡)</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var suministro in Model.Suministros)
                    {
                        <tr>
                            <td>@suministro.id</td>
                            <td>@suministro.nombre</td>
                            <td>@suministro.marca</td>
                            <td>@suministro.presentacion</td>
                            <td>@suministro.proveedor</td>
                            <td>₡@(suministro.costo.ToString("N2"))</td>
                            <td>@suministro.cantidad</td>
                            <td>@suministro.unidad_de_medida</td>
                            <td>
                                @(suministro.costo_por_cantidad.HasValue
                                ? "₡" + suministro.costo_por_cantidad.Value.ToString("N2"): "")
                            </td>
                            <td>
                                <a href="@Url.Action("EditarSuministro", "Insumos", new { id = suministro.id })" class="btn btn-custom-pink btn-sm fas fa-pencil" title="Editar"></a>
                                <a href="@Url.Action("EliminarSuministro", "Insumos", new { id = suministro.id })" class="btn btn-danger btn-sm btn-eliminar fas fa-trash" title="Eliminar" data-url="@Url.Action("EliminarSuministro", "Insumos", new { id = suministro.id })"></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script src="~/Templates/js/insumos.js"></script>
    @Html.Partial("accion_exitosa")
}

@model Proyecto_CreandoRecuerdos.Models.InsumosModel

@{
    ViewData["Title"] = "Gestión de Costos de Empaques y Decoraciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool editando = ViewBag.Editando ?? false;
    var empaqueDecoracionEditado = Model.EmpaqueDecoracionEditado;
    string titulo = editando ? "Edición de Empaques y/o Decoraciones" : "Registro de Empaques y/o Decoraciones";
    string textoBoton = editando ? "Actualizar" : "Agregar";
    string accion = editando ? "EditarEmpaqueDecoracion" : "CrearEmpaqueDecoracion";
}

@section Styles {
    <link href="~/Templates/css/insumos.css" rel="stylesheet" />
    }

<div class="container my-5 text-center">
    <h2 class="mb-4" style="font-family: 'Sono';">
        <i class="fas fa-calculator me-2"></i> Gestión de Costos de Empaques y/o Decoraciones
    </h2>
</div>

<!-- Formulario de búsqueda -->
<form method="get" action="@Url.Action("empaques_decoraciones", "Insumos")" class="container mt-4">
    <h4><strong>Búsqueda de Empaques y/o Decoraciones</strong></h4>
    <div class="input-group mb-4">
        <input type="text" name="search" class="form-control" placeholder="Buscar por cualquier campo..." value="@ViewBag.Search" />
        <button type="submit" class="fas fa-search ms-1 btn btn-custom-pink" title="Buscar"></button>
    </div>
</form>

<!-- Formulario de registro/edición -->
<div class="container">
    <h4 class="mb-3"><strong>@titulo</strong></h4>
    @using (Html.BeginForm(accion, "Insumos", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        if (editando)
        {
            @:<input type="hidden" name="id" value="@empaqueDecoracionEditado.id" />
        }

        if (ViewBag.Errores != null)
        {
            @:<script>
           @:     $(function () {
           @:         Swal.fire({
           @:             icon: 'error',
           @:             title: 'Validación',
           @:             html: '@Html.Raw(string.Join("<br/>", (IEnumerable<string>)ViewBag.Errores))',
           @:             confirmButtonText: 'Aceptar',
           @:             confirmButtonColor: '#E27AB0'
           @:         });
           @:     });
           @: </script>
        }

        <div class="mb-3 text-start">
            <label for="nombre" class="form-label">Nombre</label>
            <input type="text" name="nombre" id="nombre" class="form-control" value="@(editando ? empaqueDecoracionEditado.nombre : "")" />
        </div>

        <div class="mb-3 text-start">
            <label for="marca" class="form-label">Marca</label>
            <input type="text" name="marca" id="marca" class="form-control" value="@(editando ? empaqueDecoracionEditado.marca : "")" />
        </div>

        <div class="mb-3 text-start">
            <label for="presentacion" class="form-label">Presentación</label>
            <input type="text" name="presentacion" id="presentacion" class="form-control" value="@(editando ? empaqueDecoracionEditado.presentacion : "")" />
        </div>

        <div class="mb-3 text-start">
            <label for="proveedor" class="form-label">Proveedor</label>
            <input type="text" name="proveedor" id="proveedor" class="form-control" value="@(editando ? empaqueDecoracionEditado.proveedor : "")" />
        </div>

        <div class="mb-3 text-start">
            <label for="costo" class="form-label">Costo</label>
            <input type="number" name="costo" id="costo" class="form-control" value="@(editando ? empaqueDecoracionEditado.costo.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : "")" step="0.01" lang="en" />
        </div>

        <div class="mb-3 text-start">
            <label for="cantidad" class="form-label">Cantidad</label>
            <input type="number" name="cantidad" id="cantidad" class="form-control" value="@(editando ? empaqueDecoracionEditado.cantidad.ToString() : "")" />
        </div>

        <div class="mb-3 text-start">
            <label for="unidad_de_medida" class="form-label">Unidad de Medida</label>
            <input type="text" name="unidad_de_medida" id="unidad_de_medida" class="form-control" value="@(editando ? empaqueDecoracionEditado.unidad_de_medida : "")" />
        </div>

        <div class="d-flex justify-content-end gap-2">
            @if (editando)
            {
                <a href="@Url.Action("empaques_decoraciones", "Insumos")" class="btn btn-secondary">Salir</a>
            }
            <button type="reset" class="btn btn-danger">Cancelar</button>
            <button type="submit" class="btn btn-custom-pink">@textoBoton</button>
        </div>
    }
</div>

<!-- Listado -->
<div class="container">
    <h4><strong>Listado de Empaques y/o Decoraciones</strong></h4>
    @if (Model.EmpaquesDecoraciones == null || Model.EmpaquesDecoraciones.Count == 0)
    {
        <div class="alert alert-info text-center" style="margin: 1rem 0;">
            @if (!string.IsNullOrEmpty(ViewBag.Search as string))
            {
                <span>No se encontraron coincidencias.</span>
            }
            else
            {
                <span>No hay empaques y/o decoraciones registrados(as).</span>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table id="tabla_empaques_decoraciones" class="table table-bordered table-striped table-sm text-center">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Marca</th>
                        <th>Presentación</th>
                        <th>Proveedor</th>
                        <th>Costo (₡)</th>
                        <th>Cantidad</th>
                        <th>Unidad de Medida</th>
                        <th>Costo por Cantidad (₡)</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var empaque_decoracion in Model.EmpaquesDecoraciones)
                    {
                        <tr>
                            <td>@empaque_decoracion.id</td>
                            <td>@empaque_decoracion.nombre</td>
                            <td>@empaque_decoracion.marca</td>
                            <td>@empaque_decoracion.presentacion</td>
                            <td>@empaque_decoracion.proveedor</td>
                            <td>₡@(empaque_decoracion.costo.ToString("N2"))</td>
                            <td>@empaque_decoracion.cantidad</td>
                            <td>@empaque_decoracion.unidad_de_medida</td>
                            <td>
                                @(empaque_decoracion.costo_por_cantidad.HasValue
                                ? "₡" + empaque_decoracion.costo_por_cantidad.Value.ToString("N2"): "")
                            </td>
                            <td>
                                <a href="@Url.Action("EditarEmpaqueDecoracion", "Insumos", new { id = empaque_decoracion.id })" class="btn btn-custom-pink btn-sm fas fa-pencil" title="Editar"></a>
                                <a href="@Url.Action("EliminarEmpaqueDecoracion", "Insumos", new { id = empaque_decoracion.id })" class="btn btn-danger btn-sm btn-eliminar fas fa-trash" title="Eliminar" data-url="@Url.Action("EliminarEmpaqueDecoracion", "Insumos", new { id = empaque_decoracion.id })"></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script src="~/Templates/js/insumos.js"></script>
    @Html.Partial("accion_exitosa")
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            const totalFilas = $('#tabla_empaques_decoraciones tbody tr').length;

            // Opciones de cantidad (como en la respuesta anterior)
            let opciones = [];
            for (let i = 5; i <= totalFilas; i += 5) {
                opciones.push(i);
            }

            const ultimoMultiplo = Math.floor(totalFilas / 5) * 5;
            const siguienteValor = totalFilas !== ultimoMultiplo ? totalFilas - 1 : null;
            if (siguienteValor && !opciones.includes(siguienteValor)) {
                opciones.push(siguienteValor);
            }

            opciones.sort((a, b) => a - b);
            const valoresNumericos = [...opciones, -1];
            const valoresVisibles = [...opciones.map(n => n.toString()), "Todos"];

            $('#tabla_empaques_decoraciones').DataTable({
                pageLength: 3, // Cantidad inicial de filas por página
                searching: false,
                pagingType: "full_numbers", // Muestra números + inicio + fin
                lengthMenu: [valoresNumericos, valoresVisibles],
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json",
                    lengthMenu: "Mostrar _MENU_ registros por página",
                    info: "Mostrando _START_ a _END_ de _TOTAL_ registros",
                    infoEmpty: "No hay registros disponibles",
                    infoFiltered: "(filtrado de _MAX_ registros totales)",
                    paginate: {
                        first: "Primer página",
                        last: "Última página",
                        previous: false,
                        next: false,
                    }
                }
            });
        });
    </script>
}

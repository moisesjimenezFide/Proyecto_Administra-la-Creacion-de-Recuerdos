@model Proyecto_CreandoRecuerdos.Models.InsumosModel

@{
    ViewData["Title"] = "Gestión de Precios Finales Sugeridos de Productos Finales";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool editando = ViewBag.Editando ?? false;
    var productoFinalEditado = Model.ProductoFinalEditado;
    string titulo = editando ? "Edición de Productos Finales" : "Registro de Productos Finales";
    string textoBoton = editando ? "Actualizar" : "Agregar";
    string accion = editando ? "EditarProductoFinal" : "CrearProductoFinal";
}

@section Styles {
    <link href="@Url.Content("~/Templates/css/insumos.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Templates/css/botones.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Templates/css/tablas.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Templates/css/paginaciones_y_exportaciones.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Templates/css/selects.css")" rel="stylesheet" />
    <style>

        /* Estilos para el checkbox de suministros utilizados */

        /* Ocultar checkbox nativo */
        .custom-checkbox input[type="checkbox"] {
            display: none;
        }

        /* Contenedor visual */
        .custom-checkbox span {
            position: relative;
            display: inline-block;
            width: 20px;
            height: 20px;
            margin-top: 10px
        }

            /* Caja personalizada */
            .custom-checkbox span::before {
                content: "";
                position: absolute;
                width: 100%;
                height: 100%;
                left: 3px;
                border: 1px solid #CED4DA;
                border-radius: 4px;
                box-sizing: border-box;
                background-color: #FFFFFF;
            }

        /* Ocultar el ícono de Font Awesome por defecto */
        .custom-checkbox i.fa-solid.fa-check {
            position: relative;
            z-index: 1; /* Para que el ícono se muestre encima del recuadro */
            color: #FFFFFF;
            font-size: 14px; /* Ajusta el tamaño del ícono si es necesario */
            opacity: 0; /* Ocultamos el ícono */
            transition: opacity 0.2s ease;
        }

        /* Mostrar el ícono y cambiar el fondo cuando el checkbox está activo */
        .custom-checkbox input[type="checkbox"]:checked + span i.fa-solid.fa-check {
            opacity: 1; /* Hacemos visible el ícono */
            position: relative;
            top: 0px;
            left: 3px;
            font-size: 18px;
            color: #FFFFFF;
        }

        /* Cambio de color al estar marcado */
        .custom-checkbox input[type="checkbox"]:checked + span::before {
            border-color: #B54885;
            background-color: #B54885;
        }

        /* Hover */
        .custom-checkbox span:hover::before {
            border-color: #B54885;
            box-shadow: 0 0 0 0.2rem rgba(226, 122, 176, 0.25);
        }
    </style>
}

<div class="container my-5 text-center">
    <h2 class="mb-4" style="font-family: 'Sono';">
        <i class="fas fa-calculator me-2"></i> Gestión de Precios Finales Sugeridos de Productos Finales
    </h2>
</div>

<!-- Formulario de búsqueda -->
<form method="get" action="@Url.Action("precio_final_sugerido", "Insumos")" class="mt-4">
    <h4><strong>Búsqueda de Productos Finales</strong></h4>
    <div class="input-group mb-4">
        <input type="text" name="search" class="form-control" placeholder="Buscar por cualquier campo..." value="@ViewBag.Search" />
        <button type="submit" class="fas fa-search ms-1 btn btn-custom-pink" title="Buscar"></button>
    </div>
</form>

<!-- Formulario de registro/edición -->
<div class="container">
    <h4 class="mb-3"><strong>@titulo</strong></h4>
    @using (Html.BeginForm(accion, "Insumos", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        if (editando)
        {
            @:<input type="hidden" name="id" value="@productoFinalEditado.id" />
        }

        if (ViewBag.Errores != null)
        {
            <script>
                $(function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Validación',
                        html: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(string.Join("<br/>", (IEnumerable<string>)ViewBag.Errores))),
                        confirmButtonText: 'Aceptar',
                        confirmButtonColor: '#CC8FAE'
                    });
                });
            </script>
        }

        <div class="mb-3 text-start">
            <label for="titulo_receta_seleccionada" class="form-label">Receta Seleccionada</label>
            <div class="col-md-4">
                @Html.DropDownList(
                    "id_receta",
                    ViewBag.Recetas as IEnumerable<SelectListItem>,
                    "Seleccione una receta",
                    new { @class = "form-control" }
                )
            </div>
            <input type="hidden" id="costo_total_receta" name="costo_total_receta" value="@(editando ? productoFinalEditado.costo_total_receta.ToString() : " 0")" />
        </div>

        <div class="mb-3 text-start">
            <label for="margen_de_utilidad" class="form-label">Margen de Utilidad (%)</label>
            <div class="input-group">
                <input type="number" name="margen_de_utilidad" id="margen_de_utilidad" class="form-control" value="@(editando ? productoFinalEditado.margen_de_utilidad.ToString("0.##") : "")" min="0" max="100" />
                <span class="input-group-text">%</span>
            </div>
        </div>

        <div class="mb-3 text-start">
            <label for="plataforma_de_envio" class="form-label">Plataforma de Envío</label>
            <select name="plataforma_de_envio" id="plataforma_de_envio" class="form-control" required="required">
                <option value="">Seleccione una plataforma de envío</option>
                <option value="Propio (0%)" @(editando && productoFinalEditado?.plataforma_de_envio == "Propio (0%)" ? "selected" : "")>Propio (0%)</option>
                <option value="PedidosYa (25%)" @(editando && productoFinalEditado?.plataforma_de_envio == "PedidosYa (25%)" ? "selected" : "")>PedidosYa (25%)</option>
                <option value="Rappi (25%)" @(editando && productoFinalEditado?.plataforma_de_envio == "Rappi (25%)" ? "selected" : "")>Rappi (25%)</option>
                <option value="DidiFood (30%)" @(editando && productoFinalEditado?.plataforma_de_envio == "DidiFood (30%)" ? "selected" : "")>DidiFood (30%)</option>
                <option value="UberEats (40%)" @(editando && productoFinalEditado?.plataforma_de_envio == "UberEats (40%)" ? "selected" : "")>UberEats (40%)</option>
            </select>
        </div>

        <!-- EMPAQUES y/o DECORACIONES -->
        <h4>Empaques y/o Decoraciones Utilizados(as)</h4>
        <div id="empaques_decoraciones-container">
            @if (editando && productoFinalEditado?.EmpaquesDecoracionesUtilizados != null && productoFinalEditado.EmpaquesDecoracionesUtilizados.Count > 0)
            {
                for (int i = 0; i < productoFinalEditado.EmpaquesDecoracionesUtilizados.Count; i++)
                {
                    var item = productoFinalEditado.EmpaquesDecoracionesUtilizados[i];

                    <div class="row fila-insumo">
                        <div class="col-md-4">
                            <br>
                            <label>Nombre</label>
                            @Html.DropDownList(
                                $"EmpaquesDecoracionesUtilizados[{i}].id_empaque_decoracion_utilizado",
                                new SelectList(ViewBag.EmpaquesDecoraciones as SelectList, "Value", "Text", item.id_empaque_decoracion_utilizado),
                                "Seleccione un empaque o decoración",
                                new { @class = "form-control" }
                            )
                        </div>

                        <div class="col-md-3">
                            <br>
                            <label>Cantidad</label>
                            <input type="number" name="EmpaquesDecoracionesUtilizados[@i].cantidad" class="form-control" value="@item.cantidad" />
                        </div>

                        <div class="col-md-3">
                            <br>
                            <label>Unidad de medida</label>
                            <input type="text" name="EmpaquesDecoracionesUtilizados[@i].unidad_de_medida" class="form-control" value="@item.unidad_de_medida" />
                        </div>

                        <div class="col-md-2">
                            <br>
                            <br>
                            <button type="button" class="btn btn-danger btn-eliminar-fila">- Eliminar</button>
                        </div>

                    </div>
                }
            }

            <div class="row fila-insumo template-empaque_decoracion" style="display: none;">
                <div class="col-md-4">
                    <br>
                    <label>Nombre</label>
                    @Html.DropDownList("EmpaquesDecoracionesUtilizados[__index__].id_empaque_decoracion_utilizado",
                    ViewBag.EmpaquesDecoraciones as SelectList,
                    "Seleccione un empaque o decoración",
                    new { @class = "form-control" })
                </div>

                <div class="col-md-3">
                    <br>
                    <label>Cantidad</label>
                    <input type="number" name="EmpaquesDecoracionesUtilizados[__index__].cantidad" placeholder="Cantidad" class="form-control" />
                </div>

                <div class="col-md-3">
                    <br>
                    <label>Unidad de medida</label>
                    <input type="text" name="EmpaquesDecoracionesUtilizados[__index__].unidad_de_medida" placeholder="Unidad de medida" class="form-control" />
                </div>

                <div class="col-md-2">
                    <br>
                    <br>
                    <button type="button" class="btn btn-danger btn-eliminar-fila">- Eliminar</button>
                </div>

            </div>

            <button type="button" class="btn btn-custom-pink mt-2 btn-agregar-fila" data-container="empaques_decoraciones-container" data-template="template-empaque_decoracion">+ Agregar Empaque o Decoración</button>
        </div>
        <br />

        <!-- IMPLEMENTOS -->
        <h4>Implementos Utilizados</h4>
        <div id="implementos-container">
            @if (editando && productoFinalEditado?.ImplementosUtilizados != null && productoFinalEditado.ImplementosUtilizados.Count > 0)
            {
                for (int i = 0; i < productoFinalEditado.ImplementosUtilizados.Count; i++)
                {
                    var item = productoFinalEditado.ImplementosUtilizados[i];

                    <div class="row fila-insumo">
                        <div class="col-md-3">
                            <br>
                            <label>Nombre</label>
                            @Html.DropDownList(
                            $"ImplementosUtilizados[{i}].id_implemento_utilizado",
                            new SelectList(ViewBag.Implementos as SelectList, "Value", "Text", item.id_implemento_utilizado),
                            "Seleccione un implemento",
                            new { @class = "form-control" }
                        )
                        </div>

                        <div class="col-md-3">
                            <br>
                            <label>Cantidad</label>
                            <input type="number" name="ImplementosUtilizados[@i].cantidad" class="form-control" value="@item.cantidad" />
                        </div>

                        <div class="col-md-3">
                            <br>
                            <label>Unidad de medida</label>
                            <input type="text" name="ImplementosUtilizados[@i].unidad_de_medida" class="form-control" value="@item.unidad_de_medida" />
                        </div>

                        <div class="col-md-2">
                            <br>
                            <br>
                            <button type="button" class="btn btn-danger btn-eliminar-fila">- Eliminar</button>
                        </div>
                    </div>
                }
            }

            <div class="row fila-insumo template-implemento" style="display: none;">
                <div class="col-md-3">
                    <br>
                    <label>Nombre</label>
                    @Html.DropDownList("ImplementosUtilizados[__index__].id_implemento_utilizado",
                    ViewBag.Implementos as SelectList,
                    "Seleccione un implemento",
                    new { @class = "form-control" })
                </div>

                <div class="col-md-3">
                    <br>
                    <label>Cantidad</label>
                    <input type="number" name="ImplementosUtilizados[__index__].cantidad" placeholder="Cantidad" class="form-control" />
                </div>

                <div class="col-md-3">
                    <br>
                    <label>Unidad de medida</label>
                    <input type="text" name="ImplementosUtilizados[__index__].unidad_de_medida" placeholder="Unidad de medida" class="form-control" />
                </div>

                <div class="col-md-2">
                    <br>
                    <br>
                    <button type="button" class="btn btn-danger btn-eliminar-fila">- Eliminar</button>
                </div>

            </div>

            <button type="button" class="btn btn-custom-pink mt-2 btn-agregar-fila" data-container="implementos-container" data-template="template-implemento">+ Agregar Implemento</button>
        </div>
        <br />

        <!-- SUMINISTROS -->
        <h4>Suministros Utilizados</h4>
        <div id="suministros-container">
            @if (editando && productoFinalEditado?.SuministrosUtilizados != null && productoFinalEditado.SuministrosUtilizados.Count > 0)
            {
                for (int i = 0; i < productoFinalEditado.SuministrosUtilizados.Count; i++)
                {
                    var item = productoFinalEditado.SuministrosUtilizados[i];

                    <div class="row fila-insumo">
                        <div class="col-md-3">
                            <br>
                            <label>Nombre</label>
                            @Html.DropDownList(
                            $"SuministrosUtilizados[{i}].id_suministro_utilizado",
                            new SelectList(ViewBag.Suministros as SelectList, "Value", "Text", item.id_suministro_utilizado),
                            "Seleccione un suministro",
                            new { @class = "form-control" }
                        )
                        </div>

                        <div class="col-md-2">
                            <br>
                            <label>Cantidad</label>
                            <input type="number" name="SuministrosUtilizados[@i].cantidad" class="form-control" value="@item.cantidad" />
                        </div>

                        <div class="col-md-2">
                            <br>
                            <label>Unidad de medida</label>
                            <input type="text" name="SuministrosUtilizados[@i].unidad_de_medida" class="form-control" value="@item.unidad_de_medida" />
                        </div>

                        <div class="col-md-5 align-items-start">
                            <div class="row">
                                <div class="col-9">
                                    <br>
                                    <label class="form-label mb-0" style="font-weight: normal;">¿Es un suministro de impresión?</label>
                                    <div class=" text-center">
                                        <label class="custom-checkbox">
                                            <input type="checkbox" name="SuministrosUtilizados[@i].es_impresion_de_facturas" @(item.es_impresion_de_facturas ? "checked" : "") />
                                            <span><i class="fa-solid fa-check"></i></span>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-3 d-flex align-items-center justify-content-end">
                                    <button type="button" class="btn btn-danger btn-eliminar-fila">- Eliminar</button>
                                </div>
                            </div>
                        </div>

                    </div>
                }
            }

            <div class="row fila-insumo template-suministro" style="display: none;">
                <div class="col-md-3">
                    <br>
                    <label>Nombre</label>
                    @Html.DropDownList("SuministrosUtilizados[__index__].id_suministro_utilizado",
                   ViewBag.Suministros as SelectList,
                   "Seleccione un suministro",
                   new { @class = "form-control" })
                </div>

                <div class="col-md-2">
                    <br>
                    <label>Cantidad</label>
                    <input type="number" name="SuministrosUtilizados[__index__].cantidad" placeholder="Cantidad" class="form-control" />
                </div>

                <div class="col-md-2">
                    <br>
                    <label>Unidad de medida</label>
                    <input type="text" name="SuministrosUtilizados[__index__].unidad_de_medida" placeholder="Unidad de medida" class="form-control" />
                </div>

                <div class="col-md-5 align-items-start">
                    <div class="row">
                        <div class="col-9">
                            <br>
                            <label class="form-label mb-0" style="font-weight: normal;">¿Es un suministro de impresión?</label>
                            <div class="text-center">
                                <label class="custom-checkbox">
                                    <input type="checkbox" name="SuministrosUtilizados[__index__].es_impresion_de_facturas" />
                                    <span><i class="fa-solid fa-check"></i></span>
                                </label>
                            </div>
                        </div>
                        <div class="col-3 d-flex align-items-center justify-content-end">
                            <button type="button" class="btn btn-danger btn-eliminar-fila">- Eliminar</button>
                        </div>
                    </div>
                </div>

            </div>
            <button type="button" class="btn btn-custom-pink mt-2 btn-agregar-fila" data-container="suministros-container" data-template="template-suministro">+ Agregar Suministro</button>
        </div>
        <br />

        <div class="mb-3 text-start">
            <label for="porcentaje_de_iva" class="form-label">Porcentaje de IVA (%)</label>
            <div class="input-group">
                <input type="number" name="porcentaje_de_iva" id="porcentaje_de_iva" class="form-control" value="@(editando ? productoFinalEditado.porcentaje_de_iva.ToString("0.##") : "")" min="0" max="100" step="0.01" />
                <span class="input-group-text">%</span>
            </div>
        </div>

        <div class="mb-3 text-start">
            <label for="porcentaje_de_servicio" class="form-label">Porcentaje de de Servicio (%)</label>
            <div class="input-group">
                <input type="number" name="porcentaje_de_servicio" id="porcentaje_de_servicio" class="form-control" value="@(editando ? productoFinalEditado.porcentaje_de_servicio.ToString("0.##") : "")" min="0" max="100" step="0.01" />
                <span class="input-group-text">%</span>
            </div>
        </div>

        <div class="mb-3 text-start">
            <label class="form-label">Costo de Receta (₡):</label>
            <div class="result-symbol">
                <span class="input-symbol-left">₡</span>
                <label id="costo_receta" class="form-result">0.00</label>
            </div>
        </div>

        <div class="mb-3 text-start">
            <label class="form-label">Costo sin Margen de Utilidad (%):</label>
            <div class="result-symbol">
                <label id="costo_sin_margen_de_utilidad" class="form-result">0.00</label>
                <span class="input-symbol-right">%</span>
            </div>
        </div>

        <div class="mb-3 text-start">
            <label class="form-label">Costo con Margen de Utilidad (₡):</label>
            <div class="result-symbol">
                <span class="input-symbol-left">₡</span>
                <label id="costo_con_margen_de_utilidad" class="form-result">0.00</label>
            </div>
        </div>

        <div class="mb-3 text-start">
            <label class="form-label">Costo Empaques/Decoraciones (₡):</label>
            <div class="result-symbol">
                <span class="input-symbol-left">₡</span>
                <label id="costo_empaque_decoracion_utilizado" class="form-result">0.00</label>
            </div>
        </div>

        <div class="mb-3 text-start">
            <label class="form-label">Costo Implementos (₡):</label>
            <div class="result-symbol">
                <span class="input-symbol-left">₡</span>
                <label id="costo_implemento_utilizado" class="form-result">0.00</label>
            </div>
        </div>

        <div class="mb-3 text-start">
            <label class="form-label">Costo Suministros (₡):</label>
            <div class="result-symbol">
                <span class="input-symbol-left">₡</span>
                <label id="costo_suministro_utilizado" class="form-result">0.00</label>
            </div>
        </div>

        <div class="mb-3 text-start">
            <label class="form-label">Costo Total de Insumos (₡):</label>
            <div class="result-symbol">
                <span class="input-symbol-left">₡</span>
                <label id="costo_total_insumos" class="form-result">0.00</label>
            </div>
        </div>

        <div class="mb-3 text-start">
            <label class="form-label">Costo de Impresión Factura por Insumo (₡):</label>
            <div class="result-symbol">
                <span class="input-symbol-left">₡</span>
                <label id="costo_de_impresion_de_factura_por_insumo" class="form-result">0.00</label>
            </div>
        </div>

        <div class="mb-3 text-start">
            <label class="form-label">Costo Total de Impresión de Factura (₡):</label>
            <div class="result-symbol">
                <span class="input-symbol-left">₡</span>
                <label id="costo_total_de_impresion_de_factura" class="form-result">0.00</label>
            </div>
        </div>

        <div class="mb-3 text-start">
            <label class="form-label">Factura por Insumo (₡):</label>
            <div class="result-symbol">
                <span class="input-symbol-left">₡</span>
                <label id="factura_por_insumo" class="form-result">0.00</label>
            </div>
        </div>

        <div class="mb-3 text-start">
            <label class="form-label">Factura Total (₡):</label>
            <div class="result-symbol">
                <span class="input-symbol-left">₡</span>
                <label id="factura_total" class="form-result">0.00</label>
            </div>
        </div>

        <div class="mb-3 text-start">
            <label class="form-label">Costo Total de Insumos por Porcentaje de Ganancia (₡):</label>
            <div class="result-symbol">
                <span class="input-symbol-left">₡</span>
                <label id="costo_total_empaque_decoracion_implemento_suministro_por_porcentaje_de_ganancia" class="form-result">0.00</label>
            </div>
        </div>

        <div class="mb-3 text-start">
            <label class="form-label">Costo con IVA (₡):</label>
            <div class="result-symbol">
                <span class="input-symbol-left">₡</span>
                <label id="costo_con_iva" class="form-result">0.00</label>
            </div>
        </div>

        <div class="mb-3 text-start">
            <label class="form-label">Costo con Servicio (₡):</label>
            <div class="result-symbol">
                <span class="input-symbol-left">₡</span>
                <label id="costo_con_servicio" class="form-result">0.00</label>
            </div>
        </div>

        <div class="mb-3 text-start">
            <label class="form-label">Envío (₡):</label>
            <div class="result-symbol">
                <span class="input-symbol-left">₡</span>
                <label id="envio" class="form-result">0.00</label>
            </div>
        </div>

        <div class="mb-3 text-start">
            <label class="form-label">Precio Final Sugerido (₡):</label>
            <div class="result-symbol">
                <span class="input-symbol-left">₡</span>
                <label id="precio_final_sugerido" class="form-result">0.00</label>
            </div>
        </div>

        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-3">
            @if (editando)
            {
                <a href="@Url.Action("precios_finales_sugeridos", "Insumos")" class="btn btn-secondary">Salir</a>
            }

            <button type="reset" class="btn btn-danger">Cancelar</button>
            <button type="submit" class="btn btn-custom-pink">@textoBoton</button>

        </div>

    }
</div>

@section ListadoInsumos {
    <!-- Listado -->
    <div class="tabla_insumos_container">
        <h4><strong>Listado de Productos Finales</strong></h4>
        @if (Model.ProductosFinales == null || Model.ProductosFinales.Count == 0)
        {
            <div class="alert alert-info text-center" style="margin: 1rem 0;">
                @if (!string.IsNullOrEmpty(ViewBag.Search as string))
                {
                    <span>No se encontraron coincidencias.</span>
                }
                else
                {
                    <span>No hay productos finales registradas.</span>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table id="tabla_insumos" class="table mb-0 table-bordered table-striped tabla-global text-center dataTable con-exportaciones" data-page-length="3">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre de Receta</th>
                            <th>Costo Total de Receta (₡)</th>
                            <th>Margen de Utilidad (%)</th>
                            <th>Costo sin Margen de Utilidad (%)</th>
                            <th>Costo con Margen de Utilidad (₡)</th>
                            <th>Empaques y/o Decoraciones Utilizados(as)</th>
                            <th>Costo por cantidad (₡)</th>
                            <th>Costo Empaques y/o Decoraciones (₡)</th>
                            <th>Implementos utilizados</th>
                            <th>Costo por cantidad (₡)</th>
                            <th>Costo Implementos (₡)</th>
                            <th>Suministros Utilizados</th>
                            <th>Costo por cantidad (₡)</th>
                            <th>Costo Suministros (₡)</th>
                            <th>Costo Total Insumos (₡)</th>
                            <th>Costo de Impresión Factura por Insumo (₡)</th>
                            <th>Costo Total de Impresión de Factura (₡)</th>
                            <th>Factura por Insumo (₡)</th>
                            <th>Factura Total (₡)</th>
                            <th>Total Insumos por Porcentaje de Ganancia (₡)</th>
                            <th>Porcentaje de IVA (%)</th>
                            <th>Porcentaje de Servicio (%)</th>
                            <th>Costo con IVA (₡)</th>
                            <th>Costo con Servicio (₡)</th>
                            <th>Plataforma de Envío</th>
                            <th>Envío (₡)</th>
                            <th>Precio Final (₡)</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="tabla-global">
                        @foreach (var productofinal in Model.ProductosFinales)
                        {
                            <tr>
                                <td>@productofinal.id</td>

                                <td>
                                    @{
                                        var receta = Model.CostosRecetas?.FirstOrDefault(r => r.nombre == productofinal.nombre_receta);
                                    }
                                    @productofinal.nombre_receta
                                </td>

                                <td>
                                    ₡@productofinal.costo_total_receta.ToString("N2")
                                </td>

                                <td>@productofinal.margen_de_utilidad%</td>
                                <td>@(100 - productofinal.margen_de_utilidad)%</td>
                                <td>₡@productofinal.costo_con_margen_de_utilidad.ToString("N2")</td>

                                <!-- Empaques y/o Decoraciones -->
                                <td>
                                    @if (productofinal.EmpaquesDecoracionesUtilizados != null && productofinal.EmpaquesDecoracionesUtilizados.Any())
                                    {
                                        foreach (var item in productofinal.EmpaquesDecoracionesUtilizados)
                                        {
                                            <div>@item.nombre (@item.cantidad @item.unidad_de_medida)</div>
                                        }
                                    }
                                    else
                                    {
                                        <div><em>Ninguno</em></div>
                                    }
                                </td>
                                <td>
                                    @if (productofinal.EmpaquesDecoracionesUtilizados != null && productofinal.EmpaquesDecoracionesUtilizados.Any())
                                    {
                                        foreach (var item in productofinal.EmpaquesDecoracionesUtilizados)
                                        {
                                            <div>₡@((item.costo_por_cantidad * item.cantidad).ToString("N2"))</div>
                                        }
                                    }
                                </td>
                                <td>
                                    ₡@productofinal.costo_empaque_decoracion_utilizado.ToString("N2")
                                </td>

                                <!-- Implementos -->
                                <td>
                                    @if (productofinal.ImplementosUtilizados != null && productofinal.ImplementosUtilizados.Any())
                                    {
                                        foreach (var item in productofinal.ImplementosUtilizados)
                                        {
                                            <div>@item.nombre (@item.cantidad @item.unidad_de_medida)</div>
                                        }
                                    }
                                    else
                                    {
                                        <div><em>Ninguno</em></div>
                                    }
                                </td>
                                <td>
                                    @if (productofinal.ImplementosUtilizados != null && productofinal.ImplementosUtilizados.Any())
                                    {
                                        foreach (var item in productofinal.ImplementosUtilizados)
                                        {
                                            <div>₡@((item.costo_por_cantidad * item.cantidad).ToString("N2"))</div>
                                        }
                                    }
                                </td>
                                <td>
                                    ₡@productofinal.costo_implemento_utilizado.ToString("N2")
                                </td>

                                <!-- Suministros -->
                                <td>
                                    @if (productofinal.SuministrosUtilizados != null && productofinal.SuministrosUtilizados.Any())
                                    {
                                        foreach (var item in productofinal.SuministrosUtilizados)
                                        {
                                            <div>
                                                @item.nombre (@item.cantidad @item.unidad_de_medida)
                                                @if (item.es_impresion_de_facturas)
                                                {
                                                    <span>(Sí es un suministro de impresión de facturas)</span>
                                                }
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div><em>Ninguno</em></div>
                                    }
                                </td>
                                <td>
                                    @if (productofinal.SuministrosUtilizados != null && productofinal.SuministrosUtilizados.Any())
                                    {
                                        foreach (var item in productofinal.SuministrosUtilizados)
                                        {
                                            <div>₡@((item.costo_por_cantidad * item.cantidad).ToString("N2"))</div>
                                        }
                                    }
                                </td>
                                <td>
                                    ₡@productofinal.costo_suministro_utilizado.ToString("N2")
                                </td>

                                <td>₡@productofinal.costo_total_insumos.ToString("N2")</td>

                                <td>₡@productofinal.costo_de_impresion_de_factura_por_insumo.ToString("N2")</td>
                                <td>₡@productofinal.costo_total_de_impresion_de_factura.ToString("N2")</td>
                                <td>₡@productofinal.factura_por_insumo.ToString("N2")</td>
                                <td>₡@productofinal.factura_total.ToString("N2")</td>
                                <td>₡@productofinal.costo_total_empaque_decoracion_implemento_suministro_por_porcentaje_de_ganancia.ToString("N2")</td>
                                <td>₡@productofinal.porcentaje_de_iva.ToString("N2")</td>
                                <td>₡@productofinal.porcentaje_de_servicio.ToString("N2")</td>
                                <td>₡@productofinal.costo_con_iva.ToString("N2")</td>
                                <td>₡@productofinal.costo_con_servicio.ToString("N2")</td>
                                <td>@productofinal.plataforma_de_envio</td>
                                <td>₡@productofinal.envio.ToString("N2")</td>
                                <td><strong>₡@productofinal.precio_final_sugerido.ToString("N2")</strong></td>

                                <td>
                                    <a href="@Url.Action("EditarProductoFinal", "Insumos", new { id = productofinal.id })" class="btn btn-custom-pink btn-sm fas fa-pencil" title="Editar"></a>
                                    <a href="@Url.Action("EliminarProductoFinal", "Insumos", new { id = productofinal.id })" class="btn btn-danger btn-sm btn-eliminar fas fa-trash" title="Eliminar" data-url="@Url.Action("EliminarProductoFinal", "Insumos", new { id = productofinal.id })"></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js" defer></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js" defer></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js" defer></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js" defer></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js" defer></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js" defer></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.colVis.min.js" defer></script>
    <script src="~/Templates/js/paginaciones_y_exportaciones.js" defer></script>
    <script src="~/Templates/js/selects.js" defer></script>
    <script src="~/Templates/js/insumos.js" defer></script>
    @Html.Partial("accion_exitosa")
    <script>
        // JavaScript para personalizar los estilos y colores del checkbox de suministros utilizados
        document.addEventListener('DOMContentLoaded', function () {
            const checkboxes = document.querySelectorAll('.custom-checkbox input[type="checkbox"]');
            checkboxes.forEach(function (checkbox) {
                checkbox.addEventListener('change', function () {
                });
            });
        });
    </script>
}
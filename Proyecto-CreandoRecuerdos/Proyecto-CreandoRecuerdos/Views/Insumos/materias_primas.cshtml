@model Proyecto_CreandoRecuerdos.Models.InsumosModel

@{
    ViewData["Title"] = "Gestión de Costos de Materias Primas";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool editando = ViewBag.Editando ?? false;
    var materiaPrimaEditado = Model.MateriaPrimaEditado;
    string titulo = editando ? "Edición de Materias Primas" : "Registro de Materias Primas";
    string textoBoton = editando ? "Actualizar" : "Agregar";
    string accion = editando ? "EditarMateriaPrima" : "CrearMateriaPrima";
}

@section Styles {
    <link href="@Url.Content("~/Templates/css/insumos.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Templates/css/tablas.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Templates/css/paginaciones_y_exportaciones.css")" rel="stylesheet" />
}

<div class="container my-5 text-center">
    <h2 class="mb-4" style="font-family: 'Sono';">
        <i class="fas fa-calculator me-2"></i>Gestión de Costos de Materias Primas
    </h2>
</div>

<!-- Formulario de búsqueda-->
<h4><strong>Búsqueda de Materias Primas</strong></h4>
<form method="get" action="@Url.Action("materias_primas", "Insumos")" class="mt-4">
    <div class="input-group mb-4">
        <input type="text" name="search" class="form-control" placeholder="Buscar por cualquier campo..." value="@ViewBag.Search" />
        <button type="submit" class=" fas fa-search ms-1 btn btn-custom-pink" title="Buscar"></button>
    </div>
</form>

<!-- Formulario de registro/edición -->
<div class="container">
    <h4 class="mb-3"><strong>@titulo</strong></h4>
    @using (Html.BeginForm(accion, "Insumos", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        if (editando)
        {
            @:<input type="hidden" name="id" value="@materiaPrimaEditado.id" />
        }

        if (ViewBag.Errores != null)
        {
            @: <script>
           @:     $(function () {
           @:         Swal.fire({
           @:             icon: 'error',
           @:             title: 'Validación',
           @:             html: '@Html.Raw(string.Join("<br/>", (IEnumerable<string>)ViewBag.Errores))',
           @:             confirmButtonText: 'Aceptar',
           @:             confirmButtonColor: '#CC8FAE'
           @:         });
           @:     });
           @: </script>
        }

        <div class="mb-3 text-start">
            <label for="nombre" class="form-label">Nombre</label>
            <input type="text" name="nombre" id="nombre" class="form-control" value="@(editando ? materiaPrimaEditado.nombre : "")" />
        </div>

        <div class="mb-3 text-start">
            <label for="marca" class="form-label">Marca</label>
            <input type="text" name="marca" id="marca" class="form-control" value="@(editando ? materiaPrimaEditado.marca : "")" />
        </div>

        <div class="mb-3 text-start">
            <label for="presentacion" class="form-label">Presentación</label>
            <input type="text" name="presentacion" id="presentacion" class="form-control" value="@(editando ? materiaPrimaEditado.presentacion : "")" />
        </div>

        <div class="mb-3 text-start">
            <label for="cantidad" class="form-label">Cantidad</label>
            <input type="number" name="cantidad" id="cantidad" class="form-control" value="@(editando ? materiaPrimaEditado.cantidad.ToString() : "")" />
        </div>

        <div class="mb-3 text-start">
            <label for="volumen_de_porcion_de_presentacion" class="form-label">Volumen de Porción de Presentación</label>
            <input type="number" name="volumen_de_porcion_de_presentacion" id="volumen_de_porcion_de_presentacion" class="form-control" value="@(editando ? (materiaPrimaEditado.volumen_de_porcion_de_presentacion.HasValue ? materiaPrimaEditado.volumen_de_porcion_de_presentacion.Value.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : "") : "")" step="0.01" lang="en" />
        </div>

        <div class="mb-3 text-start">
            <label for="unidad_de_medida_de_presentacion" class="form-label">Unidad de Medida de Presentación</label>
            <input type="text" name="unidad_de_medida_de_presentacion" id="unidad_de_medida_de_presentacion" class="form-control" value="@(editando ? materiaPrimaEditado.unidad_de_medida_de_presentacion : "")" />
        </div>

        <div class="mb-3 text-start">
            <label for="proveedor" class="form-label">Proveedor</label>
            <input type="text" name="proveedor" id="proveedor" class="form-control" value="@(editando ? materiaPrimaEditado.proveedor : "")" />
        </div>

        <div class="mb-3 text-start">
            <label for="costo" class="form-label">Costo (₡)</label>
            <div class="input-group">
                <span class="input-group-text">₡</span>
                <input type="number" name="costo" id="costo" class="form-control" value="@(editando ? materiaPrimaEditado.costo.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : "")" step="0.01" lang="en" />
            </div>
        </div>

        <div class="mb-3 text-start">
            <label for="unidad_de_medida_del_peso" class="form-label">Unidad de Medida del Peso</label>
            <input type="text" name="unidad_de_medida_del_peso" id="unidad_de_medida_del_peso" class="form-control" value="@(editando ? materiaPrimaEditado.unidad_de_medida_del_peso : "")" />
        </div>

        <div class="mb-3 text-start">
            <label for="merma_total_en_gramos" class="form-label">Merma Total en Gramos (g)</label>
            <div class="input-group">
                <input type="number" name="merma_total_en_gramos" id="merma_total_en_gramos" class="form-control" value="@(editando ? (materiaPrimaEditado.merma_total_en_gramos.HasValue ? materiaPrimaEditado.merma_total_en_gramos.Value.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : "") : "")" step="0.01" lang="en" />
                <span class="input-group-text">g</span>
            </div>
        </div>

        <div class="mb-3 text-start">
            <label class="form-label">Volumen de Porción Convertido:</label>
            <div class="result-symbol">
                <label id="volumen_de_porcion_convertido" class="form-result">0.00</label>
                <span class="input-symbol-right" id="unidad_volumen_convertido_span"></span>
            </div>
        </div>

        <div class="mb-3 text-start">
            <label class="form-label">Peso Total:</label>
            <div class="result-symbol">
                <label id="peso" class="form-result">0.00</label>
                <span class="input-symbol-right" id="unidad_peso_span"></span>
            </div>
        </div>

        <div class="mb-3 text-start">
            <label class="form-label">Costo por Gramo (₡/g):</label>
            <div class="result-symbol">
                <span class="input-symbol-left">₡</span>
                <label id="costo_por_gramo" class="form-result">0.00</label>
            </div>
        </div>

        <div class="mb-3 text-start">
            <label class="form-label">Porcentaje de Merma (%):</label>
            <div class="result-symbol">
                <label id="porcentaje_de_merma" class="form-result">0.00</label>
                <span class="input-symbol-right">%</span>
            </div>
        </div>

        <div class="mb-3 text-start">
            <label class="form-label">Costo de Merma Total (₡):</label>
            <div class="result-symbol">
                <span class="input-symbol-left">₡</span>
                <label id="costo_de_merma_total" class="form-result">0.00</label>
            </div>
        </div>

        <div class="mb-3 text-start">
            <label class="form-label">Costo Total + Merma (₡):</label>
            <div class="result-symbol">
                <span class="input-symbol-left">₡</span>
                <label id="costo_total_mas_merma_total" class="form-result">0.00</label>
            </div>
        </div>

        <div class="mb-3 text-start">
            <label class="form-label">Costo por gramo con merma (₡):</label>
            <div class="result-symbol">
                <span class="input-symbol-left">₡</span>
                <label id="costo_por_gramo_con_merma" class="form-result">0.00</label>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
            @if (editando)
            {
                <a href="@Url.Action("materias_primas", "Insumos")" class="btn btn-secondary">Salir</a>
            }
            <button type="reset" class="btn btn-danger">Cancelar</button>
            <button type="submit" class="btn btn-custom-pink">@textoBoton</button>
        </div>
    }
</div>

@section ListadoInsumos {
    <!-- Listado -->
    <div class="tabla_insumos_container">
        <h4><strong>Listado de Materias Primas</strong></h4>
        @if (Model.MateriasPrimas == null || Model.MateriasPrimas.Count == 0)
        {
            <div class="alert alert-info text-center" style="margin: 1rem 0;">
                @if (!string.IsNullOrEmpty(ViewBag.Search as string))
                {
                    <span>No se encontraron coincidencias.</span>
                }
                else
                {
                    <span>No hay materias primas registradas.</span>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table id="tabla_insumos" class="table mb-0 table-bordered table-striped tabla-global text-center dataTable con-exportaciones" data-page-length="3">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Marca</th>
                            <th>Presentación</th>
                            <th>Cantidad</th>
                            <th>Volumen de Porción de Presentación</th>
                            <th>Unidad de medida de Presentación</th>
                            <th>Volumen de Porción Convertido</th>
                            <th>Unidad de medida del Volumen de Porción Convertido</th>
                            <th>Proveedor</th>
                            <th>Costo (₡)</th>
                            <th>Peso</th>
                            <th>Unidad de Medida del Peso</th>
                            <th>Merma Total en Gramos (g)</th>
                            <th>Costo por gramo (₡/g)</th>
                            <th>Porcentaje de Merma (%)</th>
                            <th>Costo de Merma Total(₡)</th>
                            <th>Costo Total + Merma (₡)</th>
                            <th>Costo por gramo con merma (₡)</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var materia_prima in Model.MateriasPrimas)
                        {
                            <tr>
                                <td>@materia_prima.id</td>
                                <td>@materia_prima.nombre</td>
                                <td>@materia_prima.marca</td>
                                <td>@materia_prima.presentacion</td>
                                <td>@materia_prima.cantidad</td>
                                <td>@(materia_prima.volumen_de_porcion_de_presentacion.HasValue ? materia_prima.volumen_de_porcion_de_presentacion.Value.ToString("N2"): "")</td>
                                <td>@materia_prima.unidad_de_medida_de_presentacion</td>
                                <td>@(materia_prima.volumen_de_porcion_convertido.HasValue ? materia_prima.volumen_de_porcion_convertido.Value.ToString("N2") : "")</td>
                                <td>@materia_prima.unidad_de_medida_convertida</td>
                                <td>@materia_prima.proveedor</td>
                                <td>₡@(materia_prima.costo.ToString("N2"))</td>
                                <td>@(materia_prima.cantidad * materia_prima.volumen_de_porcion_convertido)</td>
                                <td>@materia_prima.unidad_de_medida_del_peso</td>
                                <td>@(materia_prima.merma_total_en_gramos.HasValue ? materia_prima.merma_total_en_gramos.Value.ToString("N2"): "")</td>
                                <td>@(materia_prima.costo_por_gramo.HasValue ? "₡" + materia_prima.costo_por_gramo.Value.ToString("N2") : "")</td>
                                <td>@(materia_prima.porcentaje_de_merma.HasValue ? materia_prima.porcentaje_de_merma.Value.ToString("N2") + "%": "")</td>
                                <td>@(materia_prima.costo_de_merma_total.HasValue ? "₡" + materia_prima.costo_de_merma_total.Value.ToString("N2"): "") </td>
                                <td>@(materia_prima.costo_total_mas_merma_total.HasValue ? "₡" + materia_prima.costo_total_mas_merma_total.Value.ToString("N2"): "")</td>
                                <td>@(materia_prima.costo_por_gramo_con_merma.HasValue ? "₡" + materia_prima.costo_por_gramo_con_merma.Value.ToString("N2"): "")</td>
                                <td>
                                    <a href="@Url.Action("EditarMateriaPrima", "Insumos", new { id = materia_prima.id })" class="btn btn-custom-pink btn-sm fas fa-pencil" title="Editar"></a>
                                    <a href="@Url.Action("EliminarMateriaPrima", "Insumos", new { id = materia_prima.id })" class="btn btn-danger btn-sm btn-eliminar fas fa-trash" title="Eliminar" data-url="@Url.Action("EliminarMateriaPrima", "Insumos", new { id = materia_prima.id })"></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@section Scripts {
    <script src="~/Templates/js/insumos.js"></script>
    @Html.Partial("accion_exitosa")
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js" defer></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js" defer></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js" defer></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js" defer></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js" defer></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js" defer></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.colVis.min.js" defer></script>
    <script src="~/Templates/js/paginaciones_y_exportaciones.js" defer></script>
}



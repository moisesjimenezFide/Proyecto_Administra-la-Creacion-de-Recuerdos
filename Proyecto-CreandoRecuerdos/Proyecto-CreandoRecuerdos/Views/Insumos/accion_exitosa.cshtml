
@{
    ViewBag.Title = "accion_exitosa";
}

@{
    var msg = TempData["SuccessMessage"];
}
@if (msg != null)
{
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11" defer></script>
    <script>
        Swal.fire({
            icon: 'success',
            iconColor: '#82E0AA',
            text: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(msg)),
            confirmButtonText: 'Aceptar',
            confirmButtonColor: '#B54885'
        });
    </script>
}